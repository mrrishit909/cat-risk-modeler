 "components": {
  "schemas": {
   "ApproveIn": {
    "properties": {
     "note": {
      "type": "string",
      "maxLength": 500,
      "minLength": 3,
      "title": "Note"
     }
    },
    "type": "object",
    "required": [
     "note"
    ],
    "title": "ApproveIn"
   },
   "CalibrateIn": {
    "properties": {
     "portfolio_id": {
      "type": "string",
      "format": "uuid",
      "title": "Portfolio Id"
     }
    },
    "type": "object",
    "required": [
     "portfolio_id"
    ],
    "title": "CalibrateIn"
   },
   "Generate": {
    "properties": {
     "seed": {
      "type": "integer",
      "maximum": 1000000.0,
      "minimum": 0.0,
      "title": "Seed",
      "default": 11
     },
     "locations": {
      "type": "integer",
      "maximum": 10000.0,
      "minimum": 100.0,
      "title": "Locations",
      "default": 10000
     }
    },
    "type": "object",
    "title": "Generate"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "ImportIn": {
    "properties": {
     "external_ref": {
      "type": "string",
      "maxLength": 60,
      "minLength": 1,
      "title": "External Ref"
     },
     "name": {
      "type": "string",
      "maxLength": 120,
      "title": "Name",
      "default": "Coastal homeowners and small commercial"
     },
     "generate": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/Generate"
       },
       {
        "type": "null"
       }
      ]
     },
     "rows": {
      "anyOf": [
       {
        "items": {
         "$ref": "#/components/schemas/Row"
        },
        "type": "array",
        "maxItems": 5000
       },
       {
        "type": "null"
       }
      ],
      "title": "Rows"
     }
    },
    "type": "object",
    "required": [
     "external_ref"
    ],
    "title": "ImportIn"
   },
   "Row": {
    "properties": {
     "ref": {
      "type": "string",
      "maxLength": 40,
      "minLength": 1,
      "title": "Ref"
     },
     "x_km": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "X Km"
     },
     "y_km": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Y Km"
     },
     "postal_zone": {
      "anyOf": [
       {
        "type": "string",
        "maxLength": 20
       },
       {
        "type": "null"
       }
      ],
      "title": "Postal Zone",
      "description": "when there is no rooftop geocode, e.g. PZ-39-0"
     },
     "town": {
      "type": "string",
      "maxLength": 40,
      "title": "Town",
      "default": "Port Ellis"
     },
     "elevation_m": {
      "type": "number",
      "maximum": 500.0,
      "minimum": -5.0,
      "title": "Elevation M",
      "default": 2.0
     },
     "construction": {
      "type": "string",
      "title": "Construction"
     },
     "year_built": {
      "type": "integer",
      "maximum": 2100.0,
      "minimum": 1800.0,
      "title": "Year Built"
     },
     "roof": {
      "type": "string",
      "pattern": "^(hip|gable)$",
      "title": "Roof",
      "default": "gable"
     },
     "stories": {
      "type": "integer",
      "maximum": 60.0,
      "minimum": 1.0,
      "title": "Stories",
      "default": 1
     },
     "occupancy": {
      "type": "string",
      "pattern": "^(residential|commercial)$",
      "title": "Occupancy",
      "default": "residential"
     },
     "building_value": {
      "type": "number",
      "title": "Building Value"
     },
     "contents_value": {
      "type": "number",
      "minimum": 0.0,
      "title": "Contents Value",
      "default": 0
     },
     "time_element_value": {
      "type": "number",
      "minimum": 0.0,
      "title": "Time Element Value",
      "default": 0
     },
     "deductible_pct": {
      "type": "number",
      "maximum": 0.5,
      "minimum": 0.0,
      "title": "Deductible Pct",
      "default": 0.02
     },
     "deductible_usd": {
      "type": "number",
      "minimum": 0.0,
      "title": "Deductible Usd",
      "default": 0
     },
     "surge_covered": {
      "type": "boolean",
      "title": "Surge Covered",
      "default": false
     }
    },
    "type": "object",
    "required": [
     "ref",
     "construction",
     "year_built",
     "building_value"
    ],
    "title": "Row"
   },
   "RunIn": {
    "properties": {
     "portfolio_id": {
      "type": "string",
      "format": "uuid",
      "title": "Portfolio Id"
     },
     "events": {
      "type": "integer",
      "maximum": 200000.0,
      "minimum": 1000.0,
      "title": "Events",
      "default": 50000
     },
     "seed": {
      "type": "integer",
      "maximum": 1000000.0,
      "minimum": 0.0,
      "title": "Seed",
      "default": 2026
     }
    },
    "type": "object",
    "required": [
     "portfolio_id"
    ],
    "title": "RunIn"
   },
   "StressIn": {
    "properties": {
     "portfolio_id": {
      "type": "string",
      "format": "uuid",
      "title": "Portfolio Id"
     },
     "name": {
      "type": "string",
      "maxLength": 80,
      "title": "Name",
      "default": "Category 4 landfall"
     },
     "town": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Town",
      "description": "aim the landfall at a town's centre, or give landfall_x_km",
      "default": "Port Ellis"
     },
     "landfall_x_km": {
      "anyOf": [
       {
        "type": "number",
        "maximum": 600.0,
        "minimum": 0.0
       },
       {
        "type": "null"
       }
      ],
      "title": "Landfall X Km"
     },
     "pressure_deficit_hpa": {
      "type": "number",
      "maximum": 120.0,
      "minimum": 8.0,
      "title": "Pressure Deficit Hpa",
      "default": 90
     },
     "rmax_km": {
      "type": "number",
      "maximum": 90.0,
      "minimum": 8.0,
      "title": "Rmax Km",
      "default": 22
     },
     "forward_speed_ms": {
      "type": "number",
      "maximum": 15.0,
      "minimum": 1.5,
      "title": "Forward Speed Ms",
      "default": 5
     },
